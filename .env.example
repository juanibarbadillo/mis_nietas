# Regionales Mis Nietas — variables de entorno
#
# Copiá este archivo a `.env` y completá con los valores de tu proyecto Supabase:
#   Supabase Studio → Project Settings → API
#
# NO commitees el archivo .env (está en .gitignore).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY-PUBLICA
